[app]

# (str) Title of your application
title = EyeSpy

# (str) Package name
package.name = eyespy

# (str) Package domain (needed for android packaging)
package.domain = org.eyespyservice

# (list) Source files to include (let it include python, images, xml, etc.)
source.include_exts = py,png,jpg,kv,atlas,xml

# (list) Source directories containing Java files to compile
android.add_src = src

# (str) Application requirements
# Add your Python dependencies here (e.g., python3, kivy)
requirements = python3,kivy

# (str) Supported orientations
orientation = portrait

# (list) Permissions
# (The Accessibility service permission is handled in your manifest)
android.permissions = INTERNET, READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE

# (str) Customized manifest file
android.manifest = android_manifest.xml

# (int) Target Android API, should be as high as possible.
android.api = 33

# (int) Minimum API your APK will support.
android.minapi = 21

# (str) Android arch to build for
android.archs = arm64-v8a, armeabi-v7a

[buildozer]

# (int) Log level (0 = error, 1 = info, 2 = debug)
log_level = 2

# (int) Display warning if buildozer is run as root (0 = False, 1 = True)
warn_on_root = 1
